# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# my.telegram.org se lo - https://my.telegram.org/apps
API_ID=1234567
API_HASH=your_api_hash_here

# generate_session.py chalake banao - ek baar phone se login karna padega
SESSION_STRING=your_telethon_session_string_here

# Admin Telegram ID - @userinfobot se milega
ADMIN_ID=123456789

# Optional - Extra admins comma separated
ADMINS=

# Optional - Force join channel
FORCE_CHANNEL=
FORCE_CHANNEL_LINK=

# Optional - Logging
LOG_LEVEL=INFO
